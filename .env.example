# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies: a long random string
AUTH_SECRET=""

# First administrator, created by `npm run db:seed` if no user exists
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur"

# Folder where uploaded files are stored (outside /public)
UPLOAD_DIR="./storage/uploads"

# --- Hosting without a persistent disk (Netlify) ---
# Hosted libSQL database (Turso). When set, it replaces the SQLite file.
# For `npm run db:turso`, put these two lines in a separate .env.turso file.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# "netlify" stores uploads in Netlify Blobs instead of UPLOAD_DIR
UPLOAD_STORAGE=""
